# Copy to .streamlit/secrets.toml for LOCAL use only.
# In Streamlit Cloud, paste real values into Settings > Secrets.
# Never commit secrets.toml or actual credentials to GitHub.
APP_PASSWORD = "REPLACE_WITH_A_LONG_UNIQUE_TEAM_PASSWORD"

# Recommended on Streamlit Cloud. Metadata AND original document bytes are
# persisted here. Obtain a PostgreSQL URL from your approved database provider.
# Use a dedicated database/role. The app creates vdd_* tables on first use.
# DATABASE_URL = "postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional local custom data directory; otherwise uses ./vendor_data:
# VENDOR_DATA_DIR = "C:/VendorDocumentDesk/vendor_data"
